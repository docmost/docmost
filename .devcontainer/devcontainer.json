{
  "name": "Docmost",
  "dockerComposeFile": "docker-compose.dev.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/docmost",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "vitest.explorer"
      ]
    }
  },

  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "Docmost Server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    }
  },

  // First start: creates .env from .env.example (dev-container hostnames,
  // generated APP_SECRET) and runs pnpm install.
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "node"
}
